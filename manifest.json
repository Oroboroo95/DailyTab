{
  "manifest_version": 2,
  "name": "DailyTab",
  "version": "1.0",
  "description": "Un plug-in per Firefox che mostra un feed di tab e segnalibri in una pagina locale offline",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "<all_urls>",
    "bookmarks"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "web_accessible_resources": ["dailytab.html", "dailytab.js", "styles.css"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "applications": {
    "gecko": {
      "id": "dailytab@example.com",
      "strict_min_version": "100.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
